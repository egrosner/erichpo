{
  "info": {
    "name": "erichpo API",
    "description": "Bidirectional GitHub-Slack PR integration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://erichpo.erichgrosner.com",
      "type": "string"
    },
    {
      "key": "githubWebhookSecret",
      "value": "",
      "type": "string"
    },
    {
      "key": "slackSigningSecret",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Returns a simple health check response."
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "GitHub Webhook - PR Opened",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/github",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "github"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-github-event", "value": "pull_request" },
              { "key": "x-github-delivery", "value": "test-delivery-001" },
              { "key": "x-hub-signature-256", "value": "sha256=<computed>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"opened\",\n  \"number\": 1,\n  \"pull_request\": {\n    \"number\": 1,\n    \"title\": \"Test PR\",\n    \"body\": \"Test PR body\",\n    \"state\": \"open\",\n    \"html_url\": \"https://github.com/org/repo/pull/1\",\n    \"user\": { \"login\": \"testuser\", \"id\": 1 },\n    \"head\": { \"ref\": \"feature-branch\", \"sha\": \"abc1234\" },\n    \"base\": { \"ref\": \"main\", \"sha\": \"def5678\" },\n    \"additions\": 10,\n    \"deletions\": 2,\n    \"changed_files\": 3,\n    \"node_id\": \"PR_node123\"\n  },\n  \"repository\": {\n    \"id\": 1,\n    \"name\": \"repo\",\n    \"full_name\": \"org/repo\",\n    \"owner\": { \"login\": \"org\", \"id\": 1 }\n  },\n  \"sender\": { \"login\": \"testuser\", \"id\": 1 },\n  \"installation\": { \"id\": 12345 }\n}"
            },
            "description": "Simulates a GitHub pull_request opened webhook event. Requires valid HMAC signature."
          }
        },
        {
          "name": "GitHub Webhook - PR Closed",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/github",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "github"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-github-event", "value": "pull_request" },
              { "key": "x-github-delivery", "value": "test-delivery-002" },
              { "key": "x-hub-signature-256", "value": "sha256=<computed>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"closed\",\n  \"number\": 1,\n  \"pull_request\": {\n    \"number\": 1,\n    \"title\": \"Test PR\",\n    \"body\": null,\n    \"state\": \"closed\",\n    \"merged\": true,\n    \"html_url\": \"https://github.com/org/repo/pull/1\",\n    \"user\": { \"login\": \"testuser\", \"id\": 1 },\n    \"head\": { \"ref\": \"feature-branch\", \"sha\": \"abc1234\" },\n    \"base\": { \"ref\": \"main\", \"sha\": \"def5678\" },\n    \"node_id\": \"PR_node123\"\n  },\n  \"repository\": {\n    \"id\": 1,\n    \"name\": \"repo\",\n    \"full_name\": \"org/repo\",\n    \"owner\": { \"login\": \"org\", \"id\": 1 }\n  },\n  \"sender\": { \"login\": \"testuser\", \"id\": 1 },\n  \"installation\": { \"id\": 12345 }\n}"
            },
            "description": "Simulates a GitHub pull_request closed/merged webhook event."
          }
        },
        {
          "name": "GitHub Webhook - Issue Comment",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/github",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "github"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-github-event", "value": "issue_comment" },
              { "key": "x-github-delivery", "value": "test-delivery-003" },
              { "key": "x-hub-signature-256", "value": "sha256=<computed>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"created\",\n  \"issue\": {\n    \"number\": 1,\n    \"title\": \"Test PR\",\n    \"pull_request\": { \"url\": \"https://api.github.com/repos/org/repo/pulls/1\" }\n  },\n  \"comment\": {\n    \"id\": 1,\n    \"body\": \"This is a test comment\",\n    \"user\": { \"login\": \"commenter\", \"id\": 2 },\n    \"html_url\": \"https://github.com/org/repo/pull/1#issuecomment-1\",\n    \"created_at\": \"2024-01-01T00:00:00Z\"\n  },\n  \"repository\": {\n    \"id\": 1,\n    \"name\": \"repo\",\n    \"full_name\": \"org/repo\",\n    \"owner\": { \"login\": \"org\", \"id\": 1 }\n  },\n  \"sender\": { \"login\": \"commenter\", \"id\": 2 },\n  \"installation\": { \"id\": 12345 }\n}"
            },
            "description": "Simulates a GitHub issue_comment created webhook event on a PR."
          }
        },
        {
          "name": "GitHub Webhook - PR Review",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/github",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "github"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-github-event", "value": "pull_request_review" },
              { "key": "x-github-delivery", "value": "test-delivery-004" },
              { "key": "x-hub-signature-256", "value": "sha256=<computed>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"submitted\",\n  \"review\": {\n    \"id\": 1,\n    \"body\": \"Looks good!\",\n    \"state\": \"approved\",\n    \"user\": { \"login\": \"reviewer\", \"id\": 3 },\n    \"html_url\": \"https://github.com/org/repo/pull/1#pullrequestreview-1\"\n  },\n  \"pull_request\": {\n    \"number\": 1,\n    \"title\": \"Test PR\",\n    \"body\": null,\n    \"state\": \"open\",\n    \"html_url\": \"https://github.com/org/repo/pull/1\",\n    \"user\": { \"login\": \"testuser\", \"id\": 1 },\n    \"head\": { \"ref\": \"feature-branch\", \"sha\": \"abc1234\" },\n    \"base\": { \"ref\": \"main\", \"sha\": \"def5678\" },\n    \"node_id\": \"PR_node123\"\n  },\n  \"repository\": {\n    \"id\": 1,\n    \"name\": \"repo\",\n    \"full_name\": \"org/repo\",\n    \"owner\": { \"login\": \"org\", \"id\": 1 }\n  },\n  \"sender\": { \"login\": \"reviewer\", \"id\": 3 },\n  \"installation\": { \"id\": 12345 }\n}"
            },
            "description": "Simulates a GitHub pull_request_review submitted webhook event."
          }
        },
        {
          "name": "GitHub Webhook - Check Run Completed",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/github",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "github"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-github-event", "value": "check_run" },
              { "key": "x-github-delivery", "value": "test-delivery-005" },
              { "key": "x-hub-signature-256", "value": "sha256=<computed>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"completed\",\n  \"check_run\": {\n    \"id\": 1,\n    \"name\": \"CI / build\",\n    \"head_sha\": \"abc1234def5678\",\n    \"status\": \"completed\",\n    \"conclusion\": \"success\",\n    \"html_url\": \"https://github.com/org/repo/runs/1\",\n    \"pull_requests\": [{ \"number\": 1 }]\n  },\n  \"repository\": {\n    \"id\": 1,\n    \"name\": \"repo\",\n    \"full_name\": \"org/repo\",\n    \"owner\": { \"login\": \"org\", \"id\": 1 }\n  },\n  \"sender\": { \"login\": \"github-actions[bot]\", \"id\": 100 },\n  \"installation\": { \"id\": 12345 }\n}"
            },
            "description": "Simulates a GitHub check_run completed webhook event."
          }
        },
        {
          "name": "Slack Events - Message",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/slack/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "slack", "events"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-slack-signature", "value": "v0=<computed>" },
              { "key": "x-slack-request-timestamp", "value": "1234567890" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"event_callback\",\n  \"token\": \"test-token\",\n  \"team_id\": \"T12345\",\n  \"api_app_id\": \"A12345\",\n  \"event\": {\n    \"type\": \"message\",\n    \"channel\": \"C12345\",\n    \"user\": \"U12345\",\n    \"text\": \"Hello from Slack!\",\n    \"ts\": \"1234567890.123456\"\n  },\n  \"event_id\": \"Ev12345\",\n  \"event_time\": 1234567890\n}"
            },
            "description": "Simulates a Slack message event. Requires valid Slack signature."
          }
        },
        {
          "name": "Slack Events - URL Verification",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/slack/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "slack", "events"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-slack-signature", "value": "v0=<computed>" },
              { "key": "x-slack-request-timestamp", "value": "1234567890" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"url_verification\",\n  \"challenge\": \"test-challenge-string\",\n  \"token\": \"test-token\"\n}"
            },
            "description": "Slack URL verification challenge. Returns the challenge string."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "User authentication endpoints. Uses workspace-scoped roles for authorization.",
      "item": [
        {
          "name": "GitHub OAuth Login",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/github",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "github"]
            },
            "description": "Redirects to GitHub OAuth consent screen. After authorization, redirects back to /api/auth/github/callback which sets an auth_token cookie and redirects to /dashboard. Note: When GitHub App has 'Request user authorization during installation' enabled, the app install flow also redirects here with installation_id and setup_action=install params, handling OrgMapping creation or wizard redirect based on encoded state."
          }
        },
        {
          "name": "Register with Email/Password",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "description": "Registers a new user with email and password. Sets an auth_token cookie on success. Password must be at least 8 characters. Returns 409 if email is already registered."
          }
        },
        {
          "name": "Login with Email/Password",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "description": "Authenticates a user with email and password. Sets an auth_token cookie on success. Returns 401 if credentials are invalid."
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns the currently authenticated user including their workspace memberships and current workspace context. Requires auth_token cookie or Bearer token."
          }
        },
        {
          "name": "Switch Workspace",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/switch-workspace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "switch-workspace"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceId\": 1\n}"
            },
            "description": "Switches the user's current workspace context. Updates the JWT with the new workspace ID. User must be a member of the target workspace."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes the current session and clears the auth_token cookie. Redirects to /."
          }
        }
      ]
    },
    {
      "name": "GitHub",
      "description": "GitHub API endpoints for user-facing operations.",
      "item": [
        {
          "name": "List Installations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/github/installations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "github", "installations"]
            },
            "description": "Lists GitHub App installations accessible to the authenticated user. Returns installations of our app only, with isLinked indicating if already connected to a Slack workspace. Requires authentication."
          }
        }
      ]
    },
    {
      "name": "OAuth",
      "item": [
        {
          "name": "Slack OAuth Install",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/oauth/slack/install?installation_id=12345&frontend_redirect=https://example.com/no-workspace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "oauth", "slack", "install"],
              "query": [
                {
                  "key": "installation_id",
                  "value": "12345",
                  "description": "GitHub App installation ID to link"
                },
                {
                  "key": "frontend_redirect",
                  "value": "https://example.com/no-workspace",
                  "description": "Optional frontend URL to redirect to after OAuth. If provided, success/error params will be added to the redirect URL."
                }
              ]
            },
            "description": "Redirects to Slack OAuth consent screen. The installation_id is encoded in the OAuth state parameter. If the user is authenticated, they will be automatically added as a workspace admin upon completion. If frontend_redirect is provided, the callback will redirect to that URL with workspace_setup=success|error query params instead of returning JSON."
          }
        },
        {
          "name": "Slack OAuth Callback",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/oauth/slack/callback?code=test-code&state=uuid-state-key",
              "host": ["{{baseUrl}}"],
              "path": ["api", "oauth", "slack", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "test-code",
                  "description": "Authorization code from Slack"
                },
                {
                  "key": "state",
                  "value": "uuid-state-key",
                  "description": "State key that maps to installation_id and optional user_id on the server"
                }
              ]
            },
            "description": "OAuth callback endpoint. Exchanges the code for a bot token, stores the SlackWorkspace, creates the OrgMapping, and creates a WorkspaceMembership for the installer as admin."
          }
        },
        {
          "name": "Slack User OAuth Connect",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/oauth/slack/user/connect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "oauth", "slack", "user", "connect"]
            },
            "description": "Initiates Slack user OAuth flow for impersonation. Requires authentication. Redirects to Slack OAuth consent screen requesting chat:write user scope. After authorization, redirects to /api/oauth/slack/user/callback which stores the user's Slack token for posting messages as them."
          }
        },
        {
          "name": "Slack User OAuth Callback",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/oauth/slack/user/callback?code=test-code&state=uuid-state-key",
              "host": ["{{baseUrl}}"],
              "path": ["api", "oauth", "slack", "user", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "test-code",
                  "description": "Authorization code from Slack"
                },
                {
                  "key": "state",
                  "value": "uuid-state-key",
                  "description": "State key that maps to user_id and workspace_id on the server"
                }
              ]
            },
            "description": "User OAuth callback endpoint. Exchanges the code for a user token, stores it in the user's WorkspaceMembership for Slack impersonation. Redirects to /dashboard with success or error query params."
          }
        },
        {
          "name": "Slack User OAuth Disconnect",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/oauth/slack/user/disconnect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "oauth", "slack", "user", "disconnect"]
            },
            "description": "Disconnects the user's Slack account for the current workspace. Removes the stored Slack user token from their WorkspaceMembership. Requires authentication."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Admin endpoints for managing the current workspace. Requires authentication with workspace admin role. All endpoints are scoped to the user's current workspace.",
      "item": [
        {
          "name": "Get Current Workspace",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/workspace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "workspace"]
            },
            "description": "Returns details about the current workspace (bot tokens are excluded)."
          }
        },
        {
          "name": "List Org Mappings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/org-mappings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "org-mappings"]
            },
            "description": "Lists GitHub installation → Slack workspace mappings for the current workspace."
          }
        },
        {
          "name": "Create Org Mapping",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/admin/org-mappings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "org-mappings"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"installationId\": 12345\n}"
            },
            "description": "Links a GitHub App installation to the current workspace. The installation must not already be linked to another workspace."
          }
        },
        {
          "name": "Delete Org Mapping",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/admin/org-mappings/:installationId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "org-mappings", ":installationId"],
              "variable": [
                {
                  "key": "installationId",
                  "value": "12345",
                  "description": "GitHub App installation ID to unlink"
                }
              ]
            },
            "description": "Unlinks a GitHub App installation from the current workspace."
          }
        },
        {
          "name": "List Slack Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/slack-users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "slack-users"]
            },
            "description": "Lists all non-bot Slack users in the current workspace."
          }
        },
        {
          "name": "List GitHub Collaborators",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/github-collaborators/:owner/:repo",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "admin",
                "github-collaborators",
                ":owner",
                ":repo"
              ],
              "variable": [
                {
                  "key": "owner",
                  "value": "org",
                  "description": "GitHub org or user"
                },
                {
                  "key": "repo",
                  "value": "repo",
                  "description": "Repository name"
                }
              ]
            },
            "description": "Lists collaborators for a GitHub repository."
          }
        },
        {
          "name": "Create/Update User Mapping",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/admin/user-mappings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "user-mappings"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUsername\": \"octocat\",\n  \"slackUserId\": \"U12345\"\n}"
            },
            "description": "Creates or updates a GitHub-to-Slack user mapping for the current workspace."
          }
        },
        {
          "name": "List User Mappings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/user-mappings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "user-mappings"]
            },
            "description": "Lists all GitHub-to-Slack user mappings for the current workspace."
          }
        },
        {
          "name": "Delete User Mapping",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/admin/user-mappings/:githubUsername",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "user-mappings", ":githubUsername"],
              "variable": [
                {
                  "key": "githubUsername",
                  "value": "octocat",
                  "description": "GitHub username to remove mapping for"
                }
              ]
            },
            "description": "Deletes a GitHub-to-Slack user mapping for the current workspace."
          }
        },
        {
          "name": "List Workspace Members",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "members"]
            },
            "description": "Lists all members of the current workspace with their roles."
          }
        },
        {
          "name": "Invite Workspace Member",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/admin/members/invite",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "members", "invite"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUsername\": \"octocat\",\n  \"role\": \"user\"\n}"
            },
            "description": "Invites a user to the current workspace by their GitHub username. The user must have logged in at least once. Role can be 'admin' or 'user' (defaults to 'user')."
          }
        },
        {
          "name": "Update Member Role",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/admin/members/:userId/role",
              "host": ["{{baseUrl}}"],
