# Server
PORT=4848
NODE_ENV=development

# GitHub App (for webhooks)
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_BASE64=base64-encoded-private-key
# OR use raw key (not recommended, use base64 instead):
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub OAuth (for user auth)
# Client ID is shown at top of GitHub App settings page (format: Iv1.xxxxxxxxxx)
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxxxx
# Generate client secret in GitHub App settings under "Client secrets"
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4847/api/auth/github/callback

# Slack App
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_OAUTH_REDIRECT_URL=https://erichpo.erichgrosner.com/api/oauth/slack/callback
# User OAuth for Slack impersonation (posting as users)
SLACK_USER_OAUTH_REDIRECT_URL=https://erichpo.erichgrosner.com/api/oauth/slack/user/callback

# Database
DATABASE_URL=file:../../database/pr-channels.db

# Channel Settings
SLACK_CHANNEL_PREFIX=_pr_

# Auth / JWT
JWT_SECRET=your-32-character-minimum-secret-key
JWT_EXPIRES_IN=7d
SESSION_MAX_AGE=604800000
# Comma-separated GitHub user IDs to grant admin role
ADMIN_GITHUB_IDS=

# Email (Resend) — required for invite-by-email
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=erichpo <noreply@yourdomain.com>

# App base URL (used for generating invite links in emails)
APP_BASE_URL=https://erichpo.erichgrosner.com
