// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// User authenticated via GitHub OAuth
model User {
  id                   Int                   @id @default(autoincrement())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  githubId             Int                   @unique
  githubUsername       String
  email                String?
  avatarUrl            String?
  githubAccessToken    String?               // OAuth token for posting as user
  sessions             Session[]
  workspaceMemberships WorkspaceMembership[]
  usedInviteLinks      InviteLink[]          @relation("UsedInviteLinks")
  createdInviteLinks   InviteLink[]          @relation("CreatedInviteLinks")

  @@map("users")
}

// Session for JWT refresh/revocation
model Session {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SlackWorkspace {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teamId      String   @unique
  teamName    String
  botToken    String
  botUserId   String?
  installedBy String?

  orgMappings          OrgMapping[]
  prChannels           PrChannelMapping[]
  userMappings         GitHubSlackUserMapping[]
  workspaceMemberships WorkspaceMembership[]
  inviteLinks          InviteLink[]

  @@map("slack_workspaces")
}

model OrgMapping {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  githubInstallationId Int      @unique
  githubOrgLogin       String?
  slackWorkspaceId     Int
  slackWorkspace       SlackWorkspace @relation(fields: [slackWorkspaceId], references: [id])

  @@map("org_mappings")
}

model PrChannelMapping {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?
  archivedAt DateTime?

  // GitHub PR identifiers
  githubRepoOwner      String
  githubRepoName       String
  githubPrNumber       Int
  githubPrNodeId       String
  githubInstallationId Int?

  // Slack channel identifiers
  slackChannelId   String @unique
  slackChannelName String

  // Slack workspace (nullable for backwards compatibility)
  slackWorkspaceId Int?
  slackWorkspace   SlackWorkspace? @relation(fields: [slackWorkspaceId], references: [id])

  // PR metadata
  prTitle  String
  prAuthor String
  prUrl    String

  // Status: open, merged, closed
  status String @default("open")

  // CI aggregation relations
  checkRunResults  CheckRunResult[]
  ciStatusMessages CiStatusMessage[]

  @@unique([githubRepoOwner, githubRepoName, githubPrNumber])
  @@index([slackChannelId])
  @@map("pr_channel_mappings")
}

model WebhookDelivery {
  id          String   @id
  source      String   // 'github' or 'slack'
  processedAt DateTime @default(now())

  @@map("webhook_deliveries")
}

model SlackMessageMapping {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  slackChannelId   String
  slackMessageTs   String
  githubCommentId  Int
  githubRepoOwner  String
  githubRepoName   String
  githubPrNumber   Int

  @@unique([slackChannelId, slackMessageTs])
  @@map("slack_message_mappings")
}

model GitHubSlackUserMapping {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  githubUsername  String
  slackUserId     String

  // Slack workspace (nullable for backwards compatibility)
  slackWorkspaceId Int?
  slackWorkspace   SlackWorkspace? @relation(fields: [slackWorkspaceId], references: [id])

  @@unique([githubUsername, slackWorkspaceId])
  @@map("github_slack_user_mappings")
}

// Stores individual check run results for CI aggregation
model CheckRunResult {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // GitHub identifiers
  checkRunId       Int
  headSha          String
  name             String
  status           String   // queued, in_progress, completed
  conclusion       String?  // success, failure, neutral, cancelled, skipped, timed_out, action_required
  detailsUrl       String

  // Link to PR channel
  prChannelMappingId Int
  prChannelMapping   PrChannelMapping @relation(fields: [prChannelMappingId], references: [id])

  @@unique([checkRunId, prChannelMappingId])
  @@index([headSha, prChannelMappingId])
  @@map("check_run_results")
}

// Stores the aggregated CI status Slack message for a commit
model CiStatusMessage {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Commit SHA this message represents
  headSha          String

  // Slack message identifiers
  slackChannelId   String
  slackMessageTs   String

  // Link to PR channel
  prChannelMappingId Int
  prChannelMapping   PrChannelMapping @relation(fields: [prChannelMappingId], references: [id])

  @@unique([headSha, prChannelMappingId])
  @@map("ci_status_messages")
}

// User membership in a Slack workspace with per-workspace role
model WorkspaceMembership {
  id               Int            @id @default(autoincrement())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  userId           Int
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slackWorkspaceId Int
  slackWorkspace   SlackWorkspace @relation(fields: [slackWorkspaceId], references: [id], onDelete: Cascade)
  role             String         @default("user") // "admin" | "user"

  // Slack notification preferences
  slackMentions Boolean @default(true) // Allow @mentions in Slack
  slackInvites  Boolean @default(true) // Allow channel invitations

  @@unique([userId, slackWorkspaceId])
  @@index([userId])
  @@index([slackWorkspaceId])
  @@map("workspace_memberships")
}

// One-time invite link for workspace membership
model InviteLink {
  id               Int            @id @default(autoincrement())
  createdAt        DateTime       @default(now())
  token            String         @unique
  expiresAt        DateTime
  usedAt           DateTime?
  usedById         Int?
  usedBy           User?          @relation("UsedInviteLinks", fields: [usedById], references: [id])
  slackWorkspaceId Int
  slackWorkspace   SlackWorkspace @relation(fields: [slackWorkspaceId], references: [id], onDelete: Cascade)
  createdById      Int
  createdBy        User           @relation("CreatedInviteLinks", fields: [createdById], references: [id])

  @@index([token])
  @@map("invite_links")
}
